{
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cfcli": "node src/cli.ts",
    "lint": "node scripts/lint.ts",
    "fix": "bun run lint --fix",
    "setup": "vale sync && vale --config .vale-narration.ini sync && node scripts/vale-patch.ts",
    "voice:envelope": "node scripts/voice-envelope.ts",
    "benchmarks": "node scripts/benchmarks.ts",
    "py:install": "uv sync --directory python",
    "py:lint": "uv run --directory python ruff check .",
    "py:fmt": "uv run --directory python ruff format .",
    "py:fmt:check": "uv run --directory python ruff format --check .",
    "py:test": "uv run --directory python pytest",
    "py:test:slow": "uv run --directory python --extra highlights pytest -m slow",
    "check:all": "bun run lint --all && bun run test && bun run py:test",
    "typecheck": "tsc",
    "test": "vitest run",
    "eval:check": "bun evals/check.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.0",
    "@tavily/core": "^0.7.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "american-british-english-translator": "^0.2.1",
    "commander": "^15.0.0",
    "cspell-lib": "^10.3.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "exa-js": "^2.23.0",
    "fastest-levenshtein": "^1.0.16",
    "firecrawl": "^4.41.0",
    "harper.js": "^2.10.0",
    "ignore": "^7.0.12",
    "jsdom": "^30.1.2",
    "markdown-table": "^3.0.4",
    "markdownlint": "^0.41.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-parse": "^11.0.0",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-rehype": "^11.1.2",
    "sentencex": "^1.0.31",
    "sharp": "^0.35.5",
    "stopword": "^3.1.5",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@oh-my-pi/pi-coding-agent": "18.9.2",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/stopword": "^2.0.3",
    "@types/yazl": "^3.3.1",
    "cspell": "^10.3.5",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
