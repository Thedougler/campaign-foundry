# Machine and secret config for scripts. Copy to `.env` (gitignored).
# Agents do not read this file; they read `user-config.md`.

# Wiki vault folder (default: <repo>/wiki)
WIKI=

# Foundry install
FOUNDRY_DATA=
FOUNDRY_APP=

# Search APIs
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Notion backup (cf backup): an internal integration token shared with the parent page
NOTION_TOKEN=
# Optional: Notion page id or URL the Backup root goes under (default: the Second Brain's Shattered Sea (campaign) page)
NOTION_BACKUP_PARENT=
