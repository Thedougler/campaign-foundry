node_modules/
.env
.env.*
!.env.example
.firecrawl/

# OS / editor
.DS_Store
*.log

# Test / build output
coverage/
dist/

# Python (python/): uv venv and tool caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# cfcli push: the Foundry module it builds and its per-Campaign manifest of what was last pushed
build/
.push/

# Obsidian per-machine state
**/.obsidian/workspace.json
**/.obsidian/workspaces.json
.trash/

# qmd: local index database and refresh state (config index.yml is tracked)
.qmd/index.sqlite*
.qmd/refresh.*

# Vale: `bun run setup` syncs packages into .vale/styles/; only our own Narration style is committed
.vale/styles/*
!.vale/styles/Narration/

# Scratch space for experiments
.scratch/

# Claude Code worktrees for isolated subagents
.claude/worktrees/

# Per-file check results, keyed by content hash (src/check/cache.ts)
.cache/

# Pre-ADR-0038 Benchmark artifacts: superseded outputs stay untracked as local history.
# The blind council's committed log (evals/bench/runs/**) and leaderboard
# (evals/bench/leaderboard.md) are tracked — do not ignore them.
/evals/benchmark-samples/**
!/evals/benchmark-samples/**/
!/evals/benchmark-samples/**/*.brief.md
/evals/benchmark.md
/evals/benchmark.json
/archive/evals-benchmark/

# Residual eval/authoring dumps; live artifacts belong in OS-temp Sessions
**/*-workspace/
/evals/audit/

# Local GM-voice example library built by scripts/voice-envelope.ts; never commit
reference/

# Ingest evidence: raw awaits Ingest, archive is provenance for files already ingested
raw/
archive/
